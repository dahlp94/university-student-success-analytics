# Copy to .env and fill in local values. Do not commit .env.

# Reporting database. Leave blank to write CSV exports only.
DATABASE_URL=postgresql://user:password@localhost:5432/student_success

# Where ingest_ipeds.py stages downloaded extracts.
IPEDS_DOWNLOAD_DIR=data/raw/ipeds

# Where Arkansas institutional files are stored.
ARKANSAS_RAW_DIR=data/raw/arkansas
